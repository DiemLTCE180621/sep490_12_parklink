generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id                       Int      @id @default(autoincrement())
  role_id                  Int
  email                    String   @unique @db.VarChar(150)
  full_name                String   @db.VarChar(100)
  phone_number             String   @db.VarChar(20)
  address                  String?  @db.VarChar(255)
  avatar_url               String?  @db.VarChar(500)
  password_hash            String?  @db.VarChar(255)
  requires_password_change Boolean  @default(true)
  status                   String   @default("PENDING") @db.VarChar(30)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  role                      Role                      @relation(fields: [role_id], references: [id])
  facility                  Facility?                 @relation("ProviderFacility")
  assigned_facilities       Facility[]                @relation("InspectorFacilities")
  transactions              System_Transaction[]
  reservations              Reservation_Request[]
  reviews                   Review[]
  complaints                Complaint[]
  notifications             Notification[]
  notification_reads        Notification_Read[]
  chat_rooms_as_customer    Chat_Room[]               @relation("CustomerRooms")
  chat_rooms_as_provider    Chat_Room[]               @relation("ProviderRooms")
  messages                  Message[]
  favorites                 Favorite[]
  updated_policies          System_Policy[]           @relation("AdminUpdatedPolicies")
  updated_timeline_settings System_Timeline_Setting[] @relation("AdminUpdatedTimelineSettings")

  @@map("users")
}

model Facility {
  id                    Int      @id @default(autoincrement())
  provider_id           Int      @unique
  assigned_inspector_id Int?
  name                  String   @db.VarChar(100)
  address               String   @db.VarChar(255)
  latitude              Float?
  longitude             Float?
  vehicle_types         Json
  capacity              Int
  available_slots       Int      @default(0)
  price_per_month       Decimal
  system_fee            Decimal?
  payment_status        String   @default("UNPAID") @db.VarChar(30)
  verification_status   String   @default("PENDING_REVIEW") @db.VarChar(30)
  visibility_status     String   @default("VISIBLE") @db.VarChar(30)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  provider               User                    @relation("ProviderFacility", fields: [provider_id], references: [id])
  assigned_inspector     User?                   @relation("InspectorFacilities", fields: [assigned_inspector_id], references: [id])
  images                 Facility_Image[]
  facility_amenities     Facility_Amenity[]
  facility_vehicle_types Facility_Vehicle_Type[]
  transactions           System_Transaction[]
  reservations           Reservation_Request[]
  reviews                Review[]
  complaints             Complaint[]
  chat_rooms             Chat_Room[]
  favorites              Favorite[]

  @@map("facilities")
}

model Facility_Image {
  id          Int     @id @default(autoincrement())
  facility_id Int
  image_url   String  @db.VarChar(500)
  is_primary  Boolean @default(false)

  facility Facility @relation(fields: [facility_id], references: [id], onDelete: Cascade)

  @@map("facility_images")
}

model System_Transaction {
  id               Int      @id @default(autoincrement())
  provider_id      Int
  facility_id      Int
  amount           Decimal
  transaction_type String   @db.VarChar(30)
  status           String   @default("PENDING") @db.VarChar(30)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  provider User     @relation(fields: [provider_id], references: [id])
  facility Facility @relation(fields: [facility_id], references: [id])

  @@map("system_transactions")
}

model Reservation_Request {
  id                 Int      @id @default(autoincrement())
  customer_id        Int
  facility_id        Int
  vehicle_info       String   @db.VarChar(255)
  desired_start_date DateTime @db.Date
  status             String   @default("PENDING") @db.VarChar(30)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  customer User     @relation(fields: [customer_id], references: [id])
  facility Facility @relation(fields: [facility_id], references: [id])

  confirmation_record Confirmation_Record?

  @@map("reservation_requests")
}

model Confirmation_Record {
  id                   Int       @id @default(autoincrement())
  contract_code        String    @unique @db.VarChar(50)
  reservation_id       Int       @unique
  parent_contract_id   Int?
  agreed_price         Decimal
  payment_deadline_day Int?
  start_date           DateTime  @db.Date
  end_date             DateTime  @db.Date
  contract_snapshot    Json
  customer_agreed_at   DateTime?
  provider_agreed_at   DateTime?
  status               String    @default("PENDING_SIGNATURE") @db.VarChar(30)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  reservation       Reservation_Request   @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
  parent_contract   Confirmation_Record?  @relation("ContractRenewals", fields: [parent_contract_id], references: [id], onDelete: SetNull)
  renewal_contracts Confirmation_Record[] @relation("ContractRenewals")

  @@map("confirmation_records")
}

model Review {
  id             Int      @id @default(autoincrement())
  customer_id    Int
  facility_id    Int
  rating         Int
  comment        String   @db.Text
  provider_reply String?  @db.Text
  status         String   @default("VISIBLE") @db.VarChar(30)
  is_flagged     Boolean  @default(false)
  flagged_reason String?  @db.Text
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  customer User     @relation(fields: [customer_id], references: [id])
  facility Facility @relation(fields: [facility_id], references: [id])

  @@map("reviews")
}

model Favorite {
  id          Int      @id @default(autoincrement())
  customer_id Int
  facility_id Int
  created_at  DateTime @default(now())

  customer User     @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facility_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, facility_id])
  @@map("favorites")
}

model Complaint {
  id             Int      @id @default(autoincrement())
  customer_id    Int
  facility_id    Int
  title          String   @db.VarChar(200)
  description    String   @db.Text
  image_urls     String[]
  status         String   @default("OPEN") @db.VarChar(30)
  admin_response String?  @db.Text
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  customer User     @relation(fields: [customer_id], references: [id])
  facility Facility @relation(fields: [facility_id], references: [id])

  @@map("complaints")
}

model Notification {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  target_role String?  @db.VarChar(30)
  title       String   @db.VarChar(200)
  content     String   @db.Text
  is_read     Boolean  @default(false)
  type        String   @db.VarChar(50)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user  User?               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reads Notification_Read[]

  @@map("notifications")
}

model Notification_Read {
  notification_id Int
  user_id         Int
  read_at         DateTime @default(now())

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([notification_id, user_id])
  @@map("notification_reads")
}

model Amenity {
  id                 Int                @id @default(autoincrement())
  name               String             @unique @db.VarChar(100)
  icon               String?            @db.VarChar(50)
  type               String?            @db.VarChar(50)
  is_active          Boolean            @default(true)
  facility_amenities Facility_Amenity[]

  @@map("amenities")
}

model Facility_Amenity {
  facility_id Int
  amenity_id  Int

  facility Facility @relation(fields: [facility_id], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenity_id], references: [id], onDelete: Cascade)

  @@id([facility_id, amenity_id])
  @@map("facility_amenities")
}

model Chat_Room {
  id          Int      @id @default(autoincrement())
  customer_id Int
  provider_id Int
  facility_id Int
  created_at  DateTime @default(now())

  customer User     @relation("CustomerRooms", fields: [customer_id], references: [id])
  provider User     @relation("ProviderRooms", fields: [provider_id], references: [id])
  facility Facility @relation(fields: [facility_id], references: [id])

  messages Message[]

  @@map("chat_rooms")
}

model Message {
  id         Int      @id @default(autoincrement())
  room_id    Int
  sender_id  Int
  content    String?  @db.Text
  media_url  String?  @db.VarChar(500)
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  room   Chat_Room @relation(fields: [room_id], references: [id], onDelete: Cascade)
  sender User      @relation(fields: [sender_id], references: [id])

  @@map("messages")
}

model Platform_Fee {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  min_slots   Int
  max_slots   Int?
  fee_amount  Decimal
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("platform_fees")
}

model System_Policy {
  id          Int      @id @default(autoincrement())
  policy_type String   @unique @db.VarChar(50)
  title       String   @db.VarChar(200)
  content     String   @db.Text
  is_active   Boolean  @default(true)
  updated_by  Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  admin User? @relation("AdminUpdatedPolicies", fields: [updated_by], references: [id])

  @@map("system_policies")
}

model Vehicle_Type {
  id          Int      @id @default(autoincrement())
  type_code   String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  facility_vehicle_types Facility_Vehicle_Type[]

  @@map("vehicle_types")
}

model Facility_Vehicle_Type {
  facility_id     Int
  vehicle_type_id Int

  facility     Facility     @relation(fields: [facility_id], references: [id], onDelete: Cascade)
  vehicle_type Vehicle_Type @relation(fields: [vehicle_type_id], references: [id], onDelete: Cascade)

  @@id([facility_id, vehicle_type_id])
  @@map("facility_vehicle_types")
}

model System_Timeline_Setting {
  id                         Int      @id @default(autoincrement())
  reservation_response_value Float    @default(12)
  reservation_response_unit  String   @default("HOURS") @db.VarChar(10)
  contract_creation_value    Float    @default(24)
  contract_creation_unit     String   @default("HOURS") @db.VarChar(10)
  contract_signing_value     Float    @default(24)
  contract_signing_unit      String   @default("HOURS") @db.VarChar(10)
  termination_notice_value   Float    @default(15)
  termination_notice_unit    String   @default("DAYS") @db.VarChar(10)
  updated_by                 Int?
  updated_at                 DateTime @updatedAt
  created_at                 DateTime @default(now())

  admin User? @relation("AdminUpdatedTimelineSettings", fields: [updated_by], references: [id])

  @@map("system_timeline_settings")
}
